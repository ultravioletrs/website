# Copy to scripts/.env.publish-image (gitignored) and fill in the token.
# Create the token under My Profile -> API Tokens -> Create Token -> Custom Token, with:
#   - Workers R2 Storage: Edit
#   - Zone -> Cache Purge -> Purge (scoped to the ultraviolet.rs zone)
CLOUDFLARE_API_TOKEN=

# Not secret - the ultraviolet.rs zone ID, visible on the domain's Overview page.
CLOUDFLARE_ZONE_ID=cbb18a791e53fb24efbeb169e48634df
