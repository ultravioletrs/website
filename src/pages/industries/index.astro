---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import ProductCTA from '../../components/ProductCTA.astro';

const industries = [
  { name: 'Government', href: '/industries/government', hero: 'cube', supporting: ['cocos'],
    problem: 'Digital sovereignty for public services.',
    blurb: 'Sovereign AI for public administration and citizen services, on national infrastructure under your jurisdiction.' },
  { name: 'Defense', href: '/industries/defense', hero: 'cube', supporting: ['cocos'],
    problem: 'Air-gapped AI for classified missions.',
    blurb: 'Disconnected, hardware-isolated AI for classified and mission-critical environments where nothing may leave.' },
  { name: 'Healthcare', href: '/industries/healthcare', hero: 'cube', supporting: ['prism'],
    problem: 'HIPAA-grade AI on data that never leaves.',
    blurb: 'Run AI on protected health data inside the hospital — and collaborate across institutions without pooling records.' },
  { name: 'Financial Services', href: '/industries/financial-services', hero: 'cube', supporting: ['prism'],
    problem: 'Private AI under strict data residency.',
    blurb: 'Risk, fraud, and analysis on confidential data, plus cross-bank collaboration for AML without sharing raw records.' },
  { name: 'Telecommunications', href: '/industries/telecommunications', hero: 'cube', supporting: ['cocos'],
    problem: 'Confidential AI across operator networks.',
    blurb: 'Multi-operator and 6G workloads on a confidential substrate — validated through EU Horizon Europe research.' },
  { name: 'Research', href: '/industries/research', hero: 'prism', supporting: ['cube'],
    problem: 'Collaborate across institutions and borders.',
    blurb: 'Privacy-preserving collaboration on shared datasets, so institutions can study together without exposing data.' },
];

const products: Record<string, { name: string }> = {
  cube: { name: 'Cube AI' }, prism: { name: 'Prism AI' }, cocos: { name: 'Cocos AI' },
};
---

<Layout title="Industries — Regulated AI Deployment | Ultraviolet" description="Ultraviolet's sovereign AI infrastructure for government, defense, healthcare, financial services, telecommunications, and research.">
  <Header />
  <main>
    <PageHero
      center
      eyebrow="Industries"
      h1={`Where sovereignty<br /><span class="hero__accent">isn't optional.</span>`}
      sub="Ultraviolet serves regulated and sovereign organizations where AI data must stay inside the perimeter — government, defense, healthcare, finance, telco, and research."
      primaryLabel="Explore products"
      primaryHref="/products/cube-ai"
      secondaryLabel="Contact sales"
      secondaryHref="/company/contact"
    />

    <section class="lens section divider-top">
      <div class="container">
        <div class="lens__grid" style="margin-top:3rem">
          {industries.map((s, i) => {
            const prods = [s.hero, ...s.supporting];
            return (
              <a class="lens__card reveal" data-delay={i % 3} href={s.href}>
                <div class="lens__card-top">
                  <h3 class="lens__name">{s.name}</h3>
                  <span class="lens__go mono" aria-hidden="true">→</span>
                </div>
                <p class="lens__problem">{s.problem}</p>
                <p class="lens__blurb">{s.blurb}</p>
                <div class="lens__foot">
                  <span class="lens__plabel">Powered by</span>
                  <span class="lens__chips">
                    {prods.map(w => (
                      <span class="lens__chip">
                        <span style={`width:7px;height:7px;background:var(--${w});display:inline-block`} aria-hidden="true"></span>
                        {products[w].name}
                      </span>
                    ))}
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <ProductCTA
      h2="Wherever your data has to live,<br />your AI can run."
      sub="Talk to the team about your specific regulatory context, deployment architecture, and compliance requirements."
      primaryLabel="Contact sales"
      primaryHref="/company/contact"
      secondaryLabel="Explore solutions"
      secondaryHref="/solutions"
      note="Apache 2.0 · Deploy anywhere · No vendor lock-in"
    />
  </main>
  <Footer />
</Layout>
