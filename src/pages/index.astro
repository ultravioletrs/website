---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HomeHero from "../components/HomeHero.astro";
import TrustStrip from "../components/TrustStrip.astro";
import Problem from "../components/Problem.astro";
import Stack from "../components/Stack.astro";
import CubeSpotlight from "../components/CubeSpotlight.astro";
import Deployment from "../components/Deployment.astro";
import PrismCocos from "../components/PrismCocos.astro";
import Principles from "../components/Principles.astro";
import Compliance from "../components/Compliance.astro";
import Industries from "../components/Industries.astro";
import FinalCTA from "../components/FinalCTA.astro";
---

<Layout
  title="Ultraviolet — Sovereign AI Infrastructure"
  description="Ultraviolet is the sovereign AI platform. Build, deploy, govern, and operate AI on infrastructure you control. Private AI. No data egress. No vendor lock-in."
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Ultraviolet",
      url: "https://www.ultraviolet.rs",
      logo: "https://www.ultraviolet.rs/img/logos/ultraviolet.png",
      foundingDate: "2023",
      description:
        "Ultraviolet is a sovereign AI infrastructure company headquartered in Belgrade, Serbia. We build open-source confidential computing and sovereign AI platforms.",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Bulevar Arsenija Čarnojevića 103",
        addressLocality: "Belgrade",
        postalCode: "11000",
        addressCountry: "RS",
      },
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "sales",
        email: "info@ultraviolet.rs",
      },
      sameAs: [
        "https://github.com/ultravioletrs",
        "https://www.linkedin.com/company/ultravioletrs",
        "https://x.com/ultravioletrs",
      ],
    })}
  />
  <Header />
  <main>
    <HomeHero />
    <TrustStrip />
    <Problem />
    <Stack />
    <CubeSpotlight />
    <Deployment />
    <PrismCocos />
    <Principles />
    <Compliance />
    <Industries />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
