---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
import ProductCTA from "../../components/ProductCTA.astro";
---

<Layout
  title="Contact Ultraviolet — Deploy Private AI on Your Terms"
  description="Got questions about pilots, deployment architectures, regulated-industry rollouts, or procurement? Contact the Ultraviolet team — we deploy on your terms."
>
  <Header />
  <main>
    <PageHero
      center
      eyebrow="Contact"
      h1={`The company that builds<br /><span class="hero__accent">sovereign AI infrastructure.</span>`}
      h1={`Deploy private AI on your terms<span class="hero__accent"> — talk to us.</span>`}
      sub="Questions about confidential computing, sovereign AI deployments, pilots, or procurement? Reach out — we'd love to help you put AI to work on your own terms."
      primaryLabel="info@ultraviolet.rs"
      primaryHref="mailto:info@ultraviolet.rs"
      secondaryLabel="Explore products"
      secondaryHref="/products/cube-ai"
    />

    <section class="section divider-top">
      <div class="container">
        <div class="contact__grid">
          <div class="contact__card surface reveal">
            <h2 class="contact__h">Get in touch</h2>
            <a class="contact__row" href="mailto:info@ultraviolet.rs">
              <span class="contact__row-k">Email</span>
              <span class="contact__row-v">info@ultraviolet.rs</span>
            </a>
            <a class="contact__row" href="mailto:careers@ultraviolet.rs">
              <span class="contact__row-k">Careers</span>
              <span class="contact__row-v">careers@ultraviolet.rs</span>
            </a>
            <a
              class="contact__row"
              href="https://app.gitter.im/#/room/#Ultraviolet_community:gitter.im"
              target="_blank"
              rel="noopener"
            >
              <span class="contact__row-k">Community</span>
              <span class="contact__row-v">Chat on Gitter ↗</span>
            </a>
          </div>
          <div class="contact__card surface reveal" data-delay="1">
            <h2 class="contact__h">Follow us</h2>
            <a
              class="contact__row"
              href="https://github.com/ultravioletrs"
              target="_blank"
              rel="noopener"
            >
              <span class="contact__row-k">GitHub</span>
              <span class="contact__row-v">@ultravioletrs ↗</span>
            </a>
            <a
              class="contact__row"
              href="https://www.linkedin.com/company/ultravioletrs"
              target="_blank"
              rel="noopener"
            >
              <span class="contact__row-k">LinkedIn</span>
              <span class="contact__row-v">Ultraviolet ↗</span>
            </a>
            <a
              class="contact__row"
              href="https://x.com/ultravioletrs"
              target="_blank"
              rel="noopener"
            >
              <span class="contact__row-k">Twitter</span>
              <span class="contact__row-v">@ultravioletrs ↗</span>
            </a>
          </div>
        </div>

        <div class="contact__addr reveal" data-delay="1">
          <div class="contact__addr-card surface">
            <div class="contact__addr-label">Office</div>
            <h3 class="contact__addr-name">Ultraviolet</h3>
            <p class="contact__addr-lines">
              Bulevar Arsenija Čarnojevića 103<br />11000 Belgrade<br />Serbia
            </p>
          </div>
          <div class="contact__map">
            <iframe
              title="Ultraviolet office location"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2268.377985058479!2d20.409364951467016!3d44.82032882973188!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x475a709e828cd3b7%3A0x5c11252c64fcf58a!2sBulevar%20Arsenija%20Carnojevica%20103%2C%2011070%2C%20Novi%20Beograd!5e0!3m2!1sen!2srs!4v1661888661151!5m2!1sen!2srs"
              width="100%"
              height="380"
              style="border:0"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>
      </div>
    </section>

    <ProductCTA
      h2="Your AI. Your infrastructure.<br />Your rules."
      sub="Talk to the team about pilots, deployment architectures, regulated-industry rollouts, and procurement — on your hardware, on your terms."
      primaryLabel="info@ultraviolet.rs"
      primaryHref="mailto:info@ultraviolet.rs"
      secondaryLabel="Explore products"
      secondaryHref="/products/cube-ai"
      note="Belgrade, Serbia · Apache 2.0 · Deploy anywhere"
    />
  </main>
  <Footer />
</Layout>
