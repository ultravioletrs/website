---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCTA from '../../components/ProductCTA.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const sorted = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
  return sorted.map((post, idx) => {
    const next: typeof sorted = [];
    for (let i = 1; next.length < 3; i++) {
      next.push(sorted[(idx + i) % sorted.length]);
    }
    return { params: { slug: post.slug }, props: { post, nextPosts: next } };
  });
}

const { post, nextPosts } = Astro.props;
const { Content } = await render(post);

function fmtDate(d: Date) {
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const coverImage = post.data.image || post.data.coverImage || `/img/blog/${post.slug}.png`;
const eyebrow = post.data.category || (post.data.tags || [])[0] || 'Blog';
const authors: { name: string; picture?: string }[] =
  post.data.authors?.length ? post.data.authors : post.data.author ? [post.data.author] : [];

function getPostAuthors(p: typeof post): { name: string; picture?: string }[] {
  return p.data.authors?.length ? p.data.authors : p.data.author ? [p.data.author] : [];
}
---

<Layout
  title={`${post.data.title} | Ultraviolet Blog`}
  description={post.data.excerpt || post.data.description}
  ogImage={coverImage}
>
  <Header />
  <main>
    <article class="post">
      <div class="container">
        <a class="arrow-link post__back" href="/blog">
          <span aria-hidden="true">←</span><span>All posts</span>
        </a>
        <div class="post__head reveal">
          <div class="post__eyebrow">{eyebrow}</div>
          <h1 class="post__title">{post.data.title}</h1>
          {authors.length > 0 && (
            <div class="post__byline">
              {authors.some(a => a.picture) && (
                <div class="blog-av-stack blog-av-stack--lg">
                  {authors.filter(a => a.picture).map(a => (
                    <img class="blog-av blog-av--lg" src={a.picture!} alt={a.name} loading="lazy" />
                  ))}
                </div>
              )}
              <div>
                <div class="post__author">{authors.map(a => a.name).join(', ')}</div>
                <div class="post__date">{fmtDate(post.data.date)}</div>
              </div>
            </div>
          )}
        </div>
        <figure class="post__cover reveal" data-delay="1">
          <img src={coverImage} alt={post.data.title} loading="eager" />
        </figure>
        <div class="article reveal">
          <Content />
        </div>
      </div>
    </article>

    {nextPosts.length > 0 && (
      <section class="section nextread divider-top">
        <div class="container">
          <div class="nextread__head">
            <div class="nextread__eyebrow">Next read</div>
            <a class="arrow-link" href="/blog">
              <span>All posts</span><span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="nextread__grid">
            {nextPosts.map((p, i) => {
              const nCover = p.data.image || p.data.coverImage || `/img/blog/${p.slug}.png`;
              const nEyebrow = p.data.category || (p.data.tags || [])[0] || 'Blog';
              const nAuthors = getPostAuthors(p);
              return (
                <a class="nr-card reveal" data-delay={i} href={`/blog/${p.slug}`}>
                  <div class="nr-card__media">
                    <img src={nCover} alt={p.data.title} loading="lazy" />
                  </div>
                  <div class="nr-card__body">
                    <span class="blog-badge">{nEyebrow}</span>
                    <h3 class="nr-card__title">{p.data.title}</h3>
                    {(p.data.excerpt || p.data.description) && (
                      <p class="nr-card__excerpt">{p.data.excerpt || p.data.description}</p>
                    )}
                    <div class="blog-meta" style="margin-top:auto">
                      {nAuthors.some(a => a.picture) && (
                        <div class="blog-av-stack">
                          {nAuthors.filter(a => a.picture).map(a => (
                            <img class="blog-av" src={a.picture!} alt={a.name} loading="lazy" />
                          ))}
                        </div>
                      )}
                      <div class="blog-meta__txt">
                        <div class="blog-meta__author">{nAuthors.map(a => a.name).join(', ')}</div>
                        <div class="blog-meta__sub">{fmtDate(p.data.date)}</div>
                      </div>
                    </div>
                    <span class="nr-card__cue">Read article <span class="ar" aria-hidden="true">→</span></span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <ProductCTA
      h2="Build on confidential AI."
      sub="Explore the products these posts are built on — or talk to the team about deploying sovereign AI on your own infrastructure."
      primaryLabel="Explore products"
      primaryHref="/products/cube-ai"
      secondaryLabel="Contact sales"
      secondaryHref="/company/contact"
      note="Apache 2.0 · Deploy anywhere · No vendor lock-in"
    />
  </main>
  <Footer />
</Layout>
