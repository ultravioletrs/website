---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import LensPage from "../../components/LensPage.astro";

export async function getStaticPaths() {
  const items = await getCollection("solutions");
  return items.map((item) => ({
    params: { slug: item.id },
    props: { data: item.data },
  }));
}

const { data } = Astro.props;
const { slug } = Astro.params;
---

<Layout title={data.title} description={data.description}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.ultraviolet.rs/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Solutions",
          item: "https://www.ultraviolet.rs/solutions/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: data.title.split(" — ")[0],
          item: `https://www.ultraviolet.rs/solutions/${slug}/`,
        },
      ],
    })}
  />
  <Header />
  <LensPage
    eyebrow={data.eyebrow}
    h1={data.h1}
    sub={data.sub}
    compH2={data.compH2}
    compBody={data.compBody}
    compHeaders={data.compHeaders}
    compRows={data.compRows}
    product={data.product}
    ctaH2={data.ctaH2}
    ctaSub={data.ctaSub}
    ctaLabel={data.ctaLabel}
    ctaHref={data.ctaHref}
    ctaExternal={data.ctaExternal}
  />
  <Footer />
</Layout>
