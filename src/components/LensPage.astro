---
import PageHero from "./PageHero.astro";
import SectionHead from "./SectionHead.astro";
import ProductCTA from "./ProductCTA.astro";
import FAQAccordion from "./FAQAccordion.astro";
import { Check } from "@lucide/astro";

interface ProductDef {
  which: string;
  name: string;
  role: string;
  blurb: string;
  points: string[];
  supporting?: { which: string; name: string; role: string; blurb: string }[];
}

interface FaqItem {
  q: string;
  a: string;
}

interface DetailItem {
  title: string;
  body: string;
  href?: string;
}

interface StepItem {
  title: string;
  body: string;
}

interface Props {
  // Core (required)
  eyebrow: string;
  h1: string;
  sub: string;
  compH2: string;
  compBody: string;
  compRows: [string, string, string][];
  compHeaders: [string, string];
  product: ProductDef;
  ctaH2: string;
  ctaSub: string;
  ctaLabel: string;
  ctaHref: string;
  ctaExternal?: boolean;

  // Optional: explainer / definition section
  explainerEyebrow?: string;
  explainerH2?: string;
  explainerBody?: string;
  explainerChips?: string[];

  // Optional: details grid
  detailsEyebrow?: string;
  detailsH2?: string;
  detailsSub?: string;
  detailsItems?: DetailItem[];

  // Optional: steps section
  stepsEyebrow?: string;
  stepsH2?: string;
  stepsSub?: string;
  stepsItems?: StepItem[];

  // Optional: FAQ
  faqs?: FaqItem[];
}

const {
  eyebrow,
  h1,
  sub,
  compH2,
  compBody,
  compRows,
  compHeaders,
  product,
  ctaH2,
  ctaSub,
  ctaLabel,
  ctaHref,
  ctaExternal,
  explainerEyebrow,
  explainerH2,
  explainerBody,
  explainerChips,
  detailsEyebrow,
  detailsH2,
  detailsSub,
  detailsItems,
  stepsEyebrow,
  stepsH2,
  stepsSub,
  stepsItems,
  faqs,
} = Astro.props;

const prodHref = `/products/${product.which}-ai`;

// Convert FAQ objects to tuple format expected by FAQAccordion
const faqTuples: [string, string][] = (faqs ?? []).map(({ q, a }) => [q, a]);
const hasFaqs = faqTuples.length > 0;
---

{
  hasFaqs && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqTuples.map(([q, a]) => ({
          "@type": "Question",
          name: q,
          acceptedAnswer: { "@type": "Answer", text: a },
        })),
      })}
    />
  )
}

<main>
  <PageHero
    center
    eyebrow={eyebrow}
    h1={h1}
    sub={sub}
    primaryLabel="Contact Sales"
    primaryHref="/company/contact"
    secondaryLabel={ctaLabel}
    secondaryHref={ctaHref}
    secondaryExternal={ctaExternal}
  />

  <!-- Explainer / definition section (optional) -->
  {
    explainerH2 && (
      <section class="comp section divider-top">
        <div class="container">
          <div class="reveal" style="max-width:62rem">
            {explainerEyebrow && (
              <span class="eyebrow">
                <span class="tick" />
                {explainerEyebrow}
              </span>
            )}
            <h2 class="comp__h2" style="margin:1.1rem 0 1.3rem" set:html={explainerH2} />
            {explainerBody && (
              <p class="comp__desc" style="font-size:1.05rem;line-height:1.72;max-width:52rem">
                {explainerBody}
              </p>
            )}
            {explainerChips && explainerChips.length > 0 && (
              <div class="comp__badges" style="margin-top:1.6rem">
                {explainerChips.map((chip) => (
                  <span class="chip">
                    <Check size={13} />
                    {chip}
                  </span>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- Comparison -->
  <section class="problem section divider-top dotgrid">
    <div class="container">
      <div class="problem__head">
        <span class="eyebrow"><span class="tick"></span>The challenge</span>
        <h2 class="problem__h2 reveal" set:html={compH2} />
        <p class="problem__intro reveal" data-delay="1">{compBody}</p>
      </div>
      <div class="problem__table reveal" data-delay="1">
        <div class="problem__thead">
          <span></span><span>{compHeaders[0]}</span><span>{compHeaders[1]}</span
          >
        </div>
        {
          compRows.map(([q, a, b]) => (
            <div class="problem__row">
              <span class="problem__q">{q}</span>
              <span class="problem__a problem__a--bad">
                <span class="problem__x">✕</span>
                {a}
              </span>
              <span class="problem__a problem__a--good">
                <Check size={16} />
                {b}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Details grid (optional) -->
  {
    detailsItems && detailsItems.length > 0 && (
      <section class="ind section divider-top dotgrid">
        <div class="container">
          <SectionHead
            eyebrow={detailsEyebrow ?? "Why it matters"}
            title={detailsH2 ?? ""}
            intro={detailsSub}
          />
          <div class="ind__grid" style="margin-top:3rem">
            {detailsItems.map(({ title, body, href }, i) => {
              const inner = (
                <>
                  <h3 class="ind__t">{title}</h3>
                  <p class="ind__d">{body}</p>
                  {href && (
                    <span class="ind__go arrow-link">
                      Learn more<span aria-hidden="true">→</span>
                    </span>
                  )}
                </>
              );
              return href ? (
                <a
                  href={href}
                  class="ind__cell reveal"
                  data-delay={i % 3}
                  style="text-decoration:none"
                >
                  {inner}
                </a>
              ) : (
                <div class="ind__cell reveal" data-delay={i % 3}>
                  {inner}
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <!-- Steps section (optional) -->
  {
    stepsItems && stepsItems.length > 0 && (
      <section class="prin section divider-top">
        <div class="container">
          <div class="prin__head reveal">
            {stepsEyebrow && (
              <span class="eyebrow">
                <span class="tick" />
                {stepsEyebrow}
              </span>
            )}
            <h2 class="prin__h2" style="margin-top:1.1rem" set:html={stepsH2 ?? ""} />
            {stepsSub && (
              <p style="color:var(--ink-2);margin-top:0.8rem;max-width:48rem">{stepsSub}</p>
            )}
          </div>
          <div class="prin__grid">
            {stepsItems.map(({ title, body }, i) => (
              <div class="prin__cell reveal" data-delay={i % 3}>
                <div class="prin__num">{String(i + 1).padStart(2, "0")}</div>
                <h3 class="prin__t">{title}</h3>
                <p class="prin__d">{body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Product mapping -->
  <section class="pmap section divider-top">
    <div class="container">
      <SectionHead
        eyebrow="How Ultraviolet solves it"
        title={`Leading with ${product.name}.`}
      />
      <div class="pmap__grid" style="margin-top:3rem">
        <article class="pmap__hero reveal">
          <span class="pmap__role" style={`color:var(--${product.which})`}>
            <span
              style={`width:8px;height:8px;background:var(--${product.which});display:inline-block`}
              aria-hidden="true"></span>
            Leads with
          </span>
          <h3 class="pmap__name">{product.name}</h3>
          <div class="pmap__role-sub">{product.role}</div>
          <p class="pmap__blurb">{product.blurb}</p>
          <ul class="pmap__points">
            {
              product.points.map((p) => (
                <li>
                  <Check size={15} style={`color:var(--${product.which})`} />
                  {p}
                </li>
              ))
            }
          </ul>
          <a class="arrow-link" href={prodHref}
            >Explore {product.name}<span aria-hidden="true">→</span></a
          >
        </article>
        <div class="pmap__support">
          {
            (product.supporting || []).map((s) => (
              <article class="pmap__sup reveal" data-delay="1">
                <span class="pmap__role" style={`color:var(--${s.which})`}>
                  <span
                    style={`width:8px;height:8px;background:var(--${s.which});display:inline-block`}
                    aria-hidden="true"
                  />
                  Supported by
                </span>
                <h4 class="pmap__sup-name">{s.name}</h4>
                <p class="pmap__sup-blurb">{s.blurb}</p>
                <a class="arrow-link" href={`/products/${s.which}-ai`}>
                  Explore {s.name}
                  <span aria-hidden="true">→</span>
                </a>
              </article>
            ))
          }
          {
            (product.supporting || []).length === 0 && (
              <article class="pmap__sup reveal" data-delay="1">
                <span class="pmap__role" style="color:var(--muted)">
                  Also available
                </span>
                <h4 class="pmap__sup-name">Prism AI</h4>
                <p class="pmap__sup-blurb">
                  Add secure multi-party collaboration to your deployment when
                  you need cross-organizational AI workloads.
                </p>
                <a class="arrow-link" href="/products/prism-ai">
                  Explore Prism AI<span aria-hidden="true">→</span>
                </a>
              </article>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ section (optional) -->
  {
    hasFaqs && (
      <section class="section divider-top dotgrid">
        <div class="container">
          <div class="prin__head reveal" style="margin-bottom:2.6rem">
            <span class="eyebrow">
              <span class="tick" />
              FAQ
            </span>
            <h2 class="prin__h2" style="margin-top:1.1rem">
              Common questions,<br />answered precisely.
            </h2>
          </div>
          <FAQAccordion items={faqTuples} reveal delay={1} id="faq" />
        </div>
      </section>
    )
  }

  <ProductCTA
    h2={ctaH2}
    sub={ctaSub}
    primaryLabel="Contact sales"
    primaryHref="/company/contact"
    secondaryLabel={ctaLabel}
    secondaryHref={ctaHref}
    secondaryExternal={ctaExternal}
    note="Apache 2.0 · Deploy anywhere · No vendor lock-in"
  />
</main>
