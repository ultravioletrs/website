---
---
<section class="hero" id="top">
  <div class="container">
    <div class="hero__split">
      <div class="hero__lead">
        <span class="eyebrow"><span class="tick" aria-hidden="true"></span>Sovereign AI Infrastructure</span>
        <h1 class="hero__h1">AI you own.<br /><span class="hero__accent">Infrastructure you control.</span></h1>
        <p class="hero__sub">Ultraviolet is a sovereign AI infrastructure company. Our products let you build, deploy, govern, and operate AI entirely inside your own perimeter — on hardware you control, with nothing leaving your network.</p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href="#stack">Explore products</a>
          <a class="btn btn--ghost" href="/company/contact">Contact sales</a>
        </div>
        <div class="hero__meta mono">
          <span><span class="hero__pulse"></span> Open-source core</span>
          <span>·</span><span>Air-gapped ready</span>
          <span>·</span><span>Model agnostic</span>
        </div>
      </div>
      <div class="hero__visual">
        <div class="fam reveal">
          <div class="fam__head">
            <span class="fam__head-org mono">Ultraviolet</span>
            <span class="fam__head-sub mono">/ product family</span>
          </div>
          <div class="fam__rows">
            <a href="/products/cube-ai" class="fam__row fam__row--flag">
              <span class="fam__row-bar" style="background:var(--cube)" aria-hidden="true"></span>
              <span class="fam__row-main">
                <span class="fam__row-top">
                  <span class="fam__logo">
                    <span class="plogo" style={`height:20px;width:${Math.round(20*3.721)}px;background-color:var(--ink);-webkit-mask-image:url('/img/logos/cube-ai-trim.png');mask-image:url('/img/logos/cube-ai-trim.png')`} role="img" aria-label="Cube AI"></span>
                  </span>
                  <em class="fam__flag mono">Flagship</em>
                </span>
                <span class="fam__role">Sovereign AI Platform</span>
                <span class="fam__blurb">Private LLM platform — inference, RAG, governance.</span>
              </span>
              <span class="fam__go mono" aria-hidden="true">→</span>
            </a>
            <a href="/products/prism-ai" class="fam__row">
              <span class="fam__row-bar" style="background:var(--prism)" aria-hidden="true"></span>
              <span class="fam__row-main">
                <span class="fam__row-top">
                  <span class="fam__logo">
                    <span class="plogo" style={`height:20px;width:${Math.round(20*5.314)}px;background-color:var(--ink);-webkit-mask-image:url('/img/logos/prism-ai-trim.png');mask-image:url('/img/logos/prism-ai-trim.png')`} role="img" aria-label="Prism AI"></span>
                  </span>
                </span>
                <span class="fam__role">Secure Collaboration</span>
                <span class="fam__blurb">Joint AI across organizations, data never exposed.</span>
              </span>
              <span class="fam__go mono" aria-hidden="true">→</span>
            </a>
            <a href="/products/cocos-ai" class="fam__row">
              <span class="fam__row-bar" style="background:var(--cocos)" aria-hidden="true"></span>
              <span class="fam__row-main">
                <span class="fam__row-top">
                  <span class="fam__logo">
                    <span class="plogo" style={`height:18px;width:${Math.round(18*1.496)}px;background-color:var(--ink);-webkit-mask-image:url('/img/logos/cocos-icon-trim.png');mask-image:url('/img/logos/cocos-icon-trim.png')`} role="img" aria-label="Cocos AI"></span>
                    <span class="fam__logo-text">Cocos AI</span>
                  </span>
                </span>
                <span class="fam__role">Confidential Computing · TEE</span>
                <span class="fam__blurb">Open foundation: TEEs and remote attestation.</span>
              </span>
              <span class="fam__go mono" aria-hidden="true">→</span>
            </a>
          </div>
          <div class="fam__foot mono">
            <span class="hero__pulse" aria-hidden="true"></span> perimeter sealed · zero egress · attested
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
