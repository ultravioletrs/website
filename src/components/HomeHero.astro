---

---

<section class="hero" id="top">
  <div class="container">
    <div class="hero__split">
      <div class="hero__lead">
        <span class="eyebrow"
          ><span class="tick" aria-hidden="true"></span>Sovereign AI
          Infrastructure</span
        >
        <h1 class="hero__h1">
          AI you own.<br /><span class="hero__accent"
            >Infrastructure you control.</span
          >
        </h1>
        <p class="hero__sub">
          Ultraviolet is a sovereign AI infrastructure company. Our products let
          you build, deploy, govern, and operate AI entirely inside your own
          perimeter — on hardware you control, with nothing leaving your
          network.
        </p>
        <div class="hero__ctas">
          <button
            class="btn btn--primary"
            id="home-demo-open"
            style="cursor:pointer">Schedule a Demo</button
          >
          <a class="btn btn--ghost" href="#stack">Explore products</a>
        </div>
        <div class="hero__meta mono">
          <span><span class="hero__pulse"></span> Open-source core</span>
          <span>·</span><span>Air-gapped ready</span>
          <span>·</span><span>Model agnostic</span>
        </div>
      </div>
      <div class="hero__visual">
        <div class="fam reveal">
          <div class="fam__head">
            <span class="fam__head-org mono">Ultraviolet</span>
            <span class="fam__head-sub mono">/ product family</span>
          </div>
          <div class="fam__rows">
            <a href="/products/cube-ai" class="fam__row fam__row--flag">
              <span
                class="fam__row-bar"
                style="background:var(--cube)"
                aria-hidden="true"></span>
              <span class="fam__row-main">
                <span class="fam__row-top">
                  <span class="fam__logo">
                    <span
                      class="plogo"
                      style={`height:20px;width:${Math.round(20 * 3.721)}px;background-color:var(--ink);-webkit-mask-image:url('/img/logos/cube-ai-trim.png');mask-image:url('/img/logos/cube-ai-trim.png')`}
                      role="img"
                      aria-label="Cube AI"></span>
                  </span>
                  <em class="fam__flag mono">Flagship</em>
                </span>
                <span class="fam__role">Sovereign AI Platform</span>
                <span class="fam__blurb"
                  >Private LLM platform — inference, RAG, governance.</span
                >
              </span>
              <span class="fam__go mono" aria-hidden="true">→</span>
            </a>
            <a href="/products/prism-ai" class="fam__row">
              <span
                class="fam__row-bar"
                style="background:var(--prism)"
                aria-hidden="true"></span>
              <span class="fam__row-main">
                <span class="fam__row-top">
                  <span class="fam__logo">
                    <span
                      class="plogo"
                      style={`height:20px;width:${Math.round(20 * 5.314)}px;background-color:var(--ink);-webkit-mask-image:url('/img/logos/prism-ai-trim.png');mask-image:url('/img/logos/prism-ai-trim.png')`}
                      role="img"
                      aria-label="Prism AI"></span>
                  </span>
                </span>
                <span class="fam__role">Secure Collaboration</span>
                <span class="fam__blurb"
                  >Joint AI across organizations, data never exposed.</span
                >
              </span>
              <span class="fam__go mono" aria-hidden="true">→</span>
            </a>
            <a href="/products/cocos-ai" class="fam__row">
              <span
                class="fam__row-bar"
                style="background:var(--cocos)"
                aria-hidden="true"></span>
              <span class="fam__row-main">
                <span class="fam__row-top">
                  <span class="fam__logo">
                    <span
                      class="plogo"
                      style={`height:18px;width:${Math.round(18 * 1.496)}px;background-color:var(--ink);-webkit-mask-image:url('/img/logos/cocos-icon-trim.png');mask-image:url('/img/logos/cocos-icon-trim.png')`}
                      role="img"
                      aria-label="Cocos AI"></span>
                    <span class="fam__logo-text">Cocos AI</span>
                  </span>
                </span>
                <span class="fam__role">Confidential Computing · TEE</span>
                <span class="fam__blurb"
                  >Open foundation: TEEs and remote attestation.</span
                >
              </span>
              <span class="fam__go mono" aria-hidden="true">→</span>
            </a>
          </div>
          <div class="fam__foot mono">
            <span class="hero__pulse" aria-hidden="true"></span> perimeter sealed
            · zero egress · attested
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Demo booking modal -->
<div
  class="prism-demo-modal"
  id="home-demo-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Schedule a demo"
>
  <div class="prism-demo-modal__backdrop" id="home-demo-backdrop"></div>
  <div class="prism-demo-modal__panel">
    <div class="prism-demo-modal__head">
      <div>
        <h2 class="prism-demo-modal__title">
          Book a <span style="color:var(--accent)">Demo</span>
        </h2>
        <p class="prism-demo-modal__sub">
          Schedule your live demo session with the Ultraviolet team.
        </p>
      </div>
      <button
        class="prism-demo-modal__close"
        id="home-demo-close"
        aria-label="Close"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line><line
            x1="6"
            y1="6"
            x2="18"
            y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="prism-demo-modal__cal">
      <iframe
        id="home-demo-iframe"
        title="Schedule a Demo with Ultraviolet"
        style="width:100%;height:100%;border:0"
        allowfullscreen></iframe>
    </div>
    <div class="prism-demo-modal__foot mono">
      <svg
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
        ><circle cx="12" cy="12" r="10"></circle><line
          x1="2"
          y1="12"
          x2="22"
          y2="12"></line><path
          d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
        ></path></svg
      >
      Secured via Google Calendar
    </div>
  </div>
</div>

<script>
  const demoModal = document.getElementById("home-demo-modal")!;
  const demoBackdrop = document.getElementById("home-demo-backdrop")!;
  const demoClose = document.getElementById("home-demo-close")!;
  const demoIframe = document.getElementById(
    "home-demo-iframe",
  ) as HTMLIFrameElement;
  const demoOpen = document.getElementById("home-demo-open")!;

  const CAL_URL =
    "https://calendar.google.com/calendar/appointments/schedules/AcZssZ2go-uvRkTNc0XR_6kDLKXLBgBoTZ4AgevaBshsjgQqxSFmuV7DJCMp2HWvOLu5EdeJtHPCguCz";

  const openDemo = () => {
    if (!demoIframe.src || demoIframe.src === "about:blank")
      demoIframe.src = CAL_URL;
    const isDark =
      document.documentElement.getAttribute("data-theme") === "dark";
    demoIframe.style.filter = isDark ? "invert(1) hue-rotate(180deg)" : "none";
    demoModal.classList.add("is-open");
    document.body.style.overflow = "hidden";
  };
  const closeDemo = () => {
    demoModal.classList.remove("is-open");
    document.body.style.overflow = "";
  };

  demoOpen.addEventListener("click", openDemo);
  demoClose.addEventListener("click", closeDemo);
  demoBackdrop.addEventListener("click", closeDemo);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeDemo();
  });
</script>
